# Local server port is handled by `next dev` (default http://localhost:3000)

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas connection string used by Better Auth / the frontend
MONGODB_URI=

# Express backend base URL (port 5000 locally)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ImgBB image upload API key (used for service banners and avatars)
IMGBB_API_KEY=

# Google OAuth (optional - only if Google sign-in is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
